diff --git i/src/renderer/PendingHealth.zig w/src/renderer/PendingHealth.zig
new file mode 100644
index 0000000..9de35db
--- /dev/null
+++ w/src/renderer/PendingHealth.zig
@@ -0,0 +1,206 @@
+//! The latest renderer health transition the app mailbox has not accepted.
+//!
+//! When frames complete on the app thread (`must_draw_from_app_thread`),
+//! that thread is also the only consumer of the app mailbox, so a blocking
+//! push there waits on itself once the mailbox is full. Transitions are
+//! pushed without blocking instead, and `App.tick` retries the pending one
+//! after each drain so the last transition is delivered even when no
+//! further frame completes.
+//!
+//! The sink's `push(Health) bool` must not block and must wake the app
+//! loop whether or not it succeeds, as `App.Mailbox.push` does.
+const PendingHealth = @This();
+
+const std = @import("std");
+const Health = @import("../renderer.zig").Health;
+
+value: ?Health = null,
+
+/// Record `health` as the latest transition and try to deliver it.
+pub fn report(self: *PendingHealth, health: Health, sink: anytype) void {
+    self.value = health;
+    self.flush(sink);
+}
+
+/// Retry the pending transition, if any.
+pub fn flush(self: *PendingHealth, sink: anytype) void {
+    const health = self.value orelse return;
+    if (!sink.push(health)) return;
+    // A transition reported during the push is newer and stays pending.
+    if (self.value == health) self.value = null;
+}
+
+const testing = std.testing;
+const BlockingQueue = @import("../datastruct/main.zig").BlockingQueue;
+
+const TestMessage = union(enum) {
+    other: u32,
+    health: Health,
+};
+
+const TestQueue = BlockingQueue(TestMessage, 64);
+
+/// Mirrors `App.Mailbox.push`: an `.instant` push that wakes either way.
+const TestSink = struct {
+    queue: *TestQueue,
+    wakeups: usize = 0,
+    reentrant: ?struct { pending: *PendingHealth, health: Health } = null,
+
+    fn push(self: *TestSink, health: Health) bool {
+        defer self.wakeups += 1;
+        const accepted = self.queue.push(testing.io, .{ .health = health }, .instant) > 0;
+        if (self.reentrant) |r| {
+            self.reentrant = null;
+            r.pending.report(r.health, self);
+        }
+        return accepted;
+    }
+
+    fn fill(self: *TestSink) void {
+        while (self.queue.push(testing.io, .{ .other = 0 }, .instant) > 0) {}
+    }
+
+    /// Drains the queue like `App.drainMailbox`, returning the health values in order.
+    fn drain(self: *TestSink, buf: []Health) []Health {
+        var n: usize = 0;
+        while (self.queue.pop(testing.io)) |msg| switch (msg) {
+            .other => {},
+            .health => |h| {
+                buf[n] = h;
+                n += 1;
+            },
+        };
+        return buf[0..n];
+    }
+};
+
+test "PendingHealth: report into a full mailbox returns and stays pending" {
+    var queue: TestQueue = .{};
+    var sink: TestSink = .{ .queue = &queue };
+    sink.fill();
+
+    var pending: PendingHealth = .{};
+    pending.report(.unhealthy, &sink);
+
+    try testing.expectEqual(@as(?Health, .unhealthy), pending.value);
+    try testing.expectEqual(@as(usize, 1), sink.wakeups);
+}
+
+test "PendingHealth: flush after a drain delivers without another frame" {
+    var queue: TestQueue = .{};
+    var sink: TestSink = .{ .queue = &queue };
+    sink.fill();
+
+    var pending: PendingHealth = .{};
+    pending.report(.unhealthy, &sink);
+
+    var buf: [64]Health = undefined;
+    try testing.expectEqual(@as(usize, 0), sink.drain(&buf).len);
+    pending.flush(&sink);
+
+    try testing.expectEqual(@as(?Health, null), pending.value);
+    try testing.expectEqualSlices(Health, &.{.unhealthy}, sink.drain(&buf));
+
+    pending.flush(&sink);
+    try testing.expectEqual(@as(usize, 2), sink.wakeups);
+}
+
+test "PendingHealth: a retry into a refilled mailbox stays pending and wakes again" {
+    var queue: TestQueue = .{};
+    var sink: TestSink = .{ .queue = &queue };
+    sink.fill();
+
+    var pending: PendingHealth = .{};
+    pending.report(.unhealthy, &sink);
+
+    var buf: [64]Health = undefined;
+    _ = sink.drain(&buf);
+    sink.fill();
+    pending.flush(&sink);
+
+    try testing.expectEqual(@as(?Health, .unhealthy), pending.value);
+    try testing.expectEqual(@as(usize, 2), sink.wakeups);
+
+    _ = sink.drain(&buf);
+    pending.flush(&sink);
+    try testing.expectEqual(@as(?Health, null), pending.value);
+    try testing.expectEqualSlices(Health, &.{.unhealthy}, sink.drain(&buf));
+}
+
+test "PendingHealth: only the latest undelivered transition is delivered" {
+    var queue: TestQueue = .{};
+    var sink: TestSink = .{ .queue = &queue };
+    sink.fill();
+
+    var pending: PendingHealth = .{};
+    pending.report(.unhealthy, &sink);
+    pending.report(.healthy, &sink);
+
+    var buf: [64]Health = undefined;
+    _ = sink.drain(&buf);
+    pending.flush(&sink);
+
+    try testing.expectEqualSlices(Health, &.{.healthy}, sink.drain(&buf));
+}
+
+test "PendingHealth: an accepted older value arrives first, then the pending newer one" {
+    var queue: TestQueue = .{};
+    var sink: TestSink = .{ .queue = &queue };
+
+    var pending: PendingHealth = .{};
+    pending.report(.unhealthy, &sink);
+    try testing.expectEqual(@as(?Health, null), pending.value);
+    sink.fill();
+    pending.report(.healthy, &sink);
+
+    var buf: [64]Health = undefined;
+    try testing.expectEqualSlices(Health, &.{.unhealthy}, sink.drain(&buf));
+    pending.flush(&sink);
+    try testing.expectEqualSlices(Health, &.{.healthy}, sink.drain(&buf));
+}
+
+test "PendingHealth: an older success never clears a newer transition" {
+    var queue: TestQueue = .{};
+    var sink: TestSink = .{ .queue = &queue };
+
+    var pending: PendingHealth = .{};
+    sink.fill();
+    pending.report(.unhealthy, &sink);
+
+    var buf: [64]Health = undefined;
+    _ = sink.drain(&buf);
+    for (0..63) |_| _ = queue.push(testing.io, .{ .other = 0 }, .instant);
+    sink.reentrant = .{ .pending = &pending, .health = .healthy };
+    pending.flush(&sink);
+
+    try testing.expectEqual(@as(?Health, .healthy), pending.value);
+    try testing.expectEqualSlices(Health, &.{.unhealthy}, sink.drain(&buf));
+    pending.flush(&sink);
+    try testing.expectEqual(@as(?Health, null), pending.value);
+    try testing.expectEqualSlices(Health, &.{.healthy}, sink.drain(&buf));
+}
+
+test "PendingHealth: removing one pending value still delivers the other's" {
+    const alloc = testing.allocator;
+    var queue: TestQueue = .{};
+    var sink: TestSink = .{ .queue = &queue };
+    sink.fill();
+
+    var surfaces: std.ArrayList(*PendingHealth) = .empty;
+    defer surfaces.deinit(alloc);
+    var live: PendingHealth = .{};
+    const doomed = try alloc.create(PendingHealth);
+    doomed.* = .{};
+    try surfaces.appendSlice(alloc, &.{ doomed, &live });
+
+    doomed.report(.unhealthy, &sink);
+    live.report(.healthy, &sink);
+
+    _ = surfaces.swapRemove(0);
+    alloc.destroy(doomed);
+
+    var buf: [64]Health = undefined;
+    _ = sink.drain(&buf);
+    for (surfaces.items) |p| p.flush(&sink);
+    try testing.expectEqualSlices(Health, &.{.healthy}, sink.drain(&buf));
+}
